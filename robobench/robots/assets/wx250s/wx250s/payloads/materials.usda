#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    doc = """Generated from Composed Stage of root layer /tmp/tmpuhhn8u3u/wx250s.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_wx250s_k35si6ao/usdex_wx250s/wx250s.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_wx250s_k35si6ao/temp_wx250s/wx250s.usd


Generated from Composed Stage of root layer /home/yilang/research/CoSiGen/robobench/robots/assets/wx250s/wx250s/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "black" (
        doc = """MJCF material 'black' = texture interbotix_black.png, which the converter dropped (leaving white). Restored as the texture's mean color: sRGB (55,56,56) -> linear."""
    )
    {
        color3f inputs:diffuseColor = (0.038, 0.04, 0.04)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/black/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/black/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/black.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/black.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/black.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/black.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }
}

