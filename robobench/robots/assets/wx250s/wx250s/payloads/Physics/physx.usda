#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "wx250s"
    doc = """Generated from Composed Stage of root layer /tmp/tmpuhhn8u3u/wx250s.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_wx250s_k35si6ao/usdex_wx250s/wx250s.usdc


