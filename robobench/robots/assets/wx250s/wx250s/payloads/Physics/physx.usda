"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "wx250s"
{
    over "Geometry"
    {
        over "tn__wx250sbase_link_jN"
        {
            over "tn__wx250sshoulder_link_lT"
            {
                over "tn__wx250supper_arm_link_WV0"
                {
                    over "tn__wx250supper_forearm_link_Yb0"
                    {
                        over "tn__wx250slower_forearm_link_Yb0"
                        {
                            over "tn__wx250swrist_link_zO"
                            {
                                over "tn__wx250sgripper_link_VS"
                                {
                                    over "tn__wx250sleft_finger_link_XY0"
                                    {
                                        over "left_finger" (
                                            prepend apiSchemas = ["PhysxJointAPI"]
                                        )
                                        {
                                            float physxJoint:armature = 0.1
                                            float physxJoint:jointFriction = 0.1
                                        }
                                    }

                                    over "tn__wx250sright_finger_link_nZ0"
                                    {
                                        over "right_finger" (
                                            prepend apiSchemas = ["PhysxJointAPI"]
                                        )
                                        {
                                            float physxJoint:armature = 0.1
                                            float physxJoint:jointFriction = 0.1
                                        }
                                    }

                                    over "wrist_rotate" (
                                        prepend apiSchemas = ["PhysxJointAPI"]
                                    )
                                    {
                                        float physxJoint:armature = 0.1
                                        float physxJoint:jointFriction = 0.1
                                    }
                                }

                                over "wrist_angle" (
                                    prepend apiSchemas = ["PhysxJointAPI"]
                                )
                                {
                                    float physxJoint:armature = 0.1
                                    float physxJoint:jointFriction = 0.1
                                }
                            }

                            over "forearm_roll" (
                                prepend apiSchemas = ["PhysxJointAPI"]
                            )
                            {
                                float physxJoint:armature = 0.1
                                float physxJoint:jointFriction = 0.1
                            }
                        }

                        over "elbow" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                            float physxJoint:armature = 0.1
                            float physxJoint:jointFriction = 0.1
                        }
                    }

                    over "shoulder" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.1
                        float physxJoint:jointFriction = 0.1
                    }
                }

                over "waist" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.1
                    float physxJoint:jointFriction = 0.1
                }
            }
        }
    }
}

