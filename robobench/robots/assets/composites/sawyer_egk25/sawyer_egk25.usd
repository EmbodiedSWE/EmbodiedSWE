#usda 1.0
(
    defaultPrim = "sawyer_egk25"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "sawyer_egk25" (
    prepend references = @../../sawyer/sawyer_instanceable.usd@
)
{
    def Xform "gripper" (
        prepend references = @../../schunk_egk25/schunk_egk_25.usd@
    )
    {
        quatd xformOp:orient = (-0.45452224940732405, 0.5416762001564557, 0.5416729176192454, 0.4545182826857727)
        double3 xformOp:scale = (0.001, 0.001, 0.001)
        double3 xformOp:translate = (0.9909997582435608, 0.16030007600784302, 0.3169998824596405)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "root_joint" (
            active = false
            delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
        )
        {
        }
    }

    def PhysicsFixedJoint "gripper_attach"
    {
        rel physics:body0 = </sawyer_egk25/right_l6/right_hand>
        rel physics:body1 = </sawyer_egk25/gripper/SCHUNK_1491752_EGK_25_PN_M_B_000ohne0>
        point3f physics:localPos0 = (0, 0, -1.110223e-16)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (0.5002499, 0.0009995004, -2.59472e-20, -2.9415235e-19)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }
}

