#usda 1.0
(
    doc = """Standalone Franka hand, carved out of the vendored panda robot by reference.

    The panda USD has no isolated hand asset (the fingers are SIBLINGS of the hand under the
    robot root, so the hand subtree alone cannot be referenced) — this wrapper references the
    whole robot, deactivates the nine arm links and the world-pinning rootJoint, and cancels the
    arm's rest offset so `panda_hand` sits at the ORIGIN with identity orientation (mount plane
    at z=0, +z toward the fingertips, fingers separating along +-y). What remains live:
    panda_hand + panda_leftfinger + panda_rightfinger + the two driven prismatic finger joints
    (metres; 0 = closed, 0.04 = open). Meshes stay single-sourced in ../franka/.

    NOTE: the referenced robot root carries PhysicsArticulationRootAPI — a consumer welding this
    hand onto an arm must strip it (delete apiSchemas) or PhysX sees two articulations."""
    defaultPrim = "PandaHand"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PandaHand" (
    prepend references = @../franka/panda_instanceable.usd@
)
{
    quatd xformOp:orient = (0, 0.9238796586798317, 0.3826835199301361, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (-0.062225340606710366, -0.062225456809990275, 0.92600055499801)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    over "panda_link0" (
        active = false
    )
    {
    }

    over "rootJoint" (
        active = false
    )
    {
    }

    over "panda_link1" (
        active = false
    )
    {
    }

    over "panda_link2" (
        active = false
    )
    {
    }

    over "panda_link3" (
        active = false
    )
    {
    }

    over "panda_link4" (
        active = false
    )
    {
    }

    over "panda_link5" (
        active = false
    )
    {
    }

    over "panda_link6" (
        active = false
    )
    {
    }

    over "panda_link7" (
        active = false
    )
    {
    }
}
