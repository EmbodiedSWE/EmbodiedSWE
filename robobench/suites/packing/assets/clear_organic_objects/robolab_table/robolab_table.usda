        quatf xformOp:orient = (1, -7.3890355e-8, 1.8723705e-7, -6.8164064e-7)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.5471951961517334, -0.000058073303080163896, -0.3470001220703125)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Scope "Looks"
