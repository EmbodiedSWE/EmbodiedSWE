#usda 1.0
(
    defaultPrim = "KitchenTable"
    metersPerUnit = 1
    upAxis = "Z"
)

# Kitchen work table for locomanip.fruit_delivery: 1.40 x 1.00 m oak-tone top,
# surface at 0.70 m, standing on the ground plane. Authored after the inline table
# in RoboLab's fruits_out_of_basket scene (scripts/author_fruit_delivery_table.py).
def Xform "KitchenTable" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    def Scope "Looks"
    {
        def Material "Oak"
        {
            token outputs:surface.connect = </KitchenTable/Looks/Oak/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.620, 0.440, 0.240)
                float inputs:metallic = 0.00
                float inputs:roughness = 0.45
                float inputs:specular = 0.5
                token outputs:surface
            }
        }
        def Material "Steel"
        {
            token outputs:surface.connect = </KitchenTable/Looks/Steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.130, 0.130, 0.140)
                float inputs:metallic = 0.80
                float inputs:roughness = 0.35
                float inputs:specular = 0.5
                token outputs:surface
            }
        }
    }
    def Cube "top" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </KitchenTable/Looks/Oak>
        color3f[] primvars:displayColor = [(0.620, 0.440, 0.240)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (0, 0, 0.6850)
        float3 xformOp:scale = (1.4000, 1.0000, 0.0300)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = 1
    }
    def Cylinder "leg_0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double height = 0.6700
        double radius = 0.0250
        uniform token axis = "Z"
        float3[] extent = [(-0.0250, -0.0250, -0.3350), (0.0250, 0.0250, 0.3350)]
        rel material:binding = </KitchenTable/Looks/Steel>
        color3f[] primvars:displayColor = [(0.130, 0.130, 0.140)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (0.6100, 0.4100, 0.3350)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:collisionEnabled = 1
    }
    def Cylinder "leg_1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double height = 0.6700
        double radius = 0.0250
        uniform token axis = "Z"
        float3[] extent = [(-0.0250, -0.0250, -0.3350), (0.0250, 0.0250, 0.3350)]
        rel material:binding = </KitchenTable/Looks/Steel>
        color3f[] primvars:displayColor = [(0.130, 0.130, 0.140)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (0.6100, -0.4100, 0.3350)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:collisionEnabled = 1
    }
    def Cylinder "leg_2" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double height = 0.6700
        double radius = 0.0250
        uniform token axis = "Z"
        float3[] extent = [(-0.0250, -0.0250, -0.3350), (0.0250, 0.0250, 0.3350)]
        rel material:binding = </KitchenTable/Looks/Steel>
        color3f[] primvars:displayColor = [(0.130, 0.130, 0.140)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (-0.6100, 0.4100, 0.3350)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:collisionEnabled = 1
    }
    def Cylinder "leg_3" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double height = 0.6700
        double radius = 0.0250
        uniform token axis = "Z"
        float3[] extent = [(-0.0250, -0.0250, -0.3350), (0.0250, 0.0250, 0.3350)]
        rel material:binding = </KitchenTable/Looks/Steel>
        color3f[] primvars:displayColor = [(0.130, 0.130, 0.140)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (-0.6100, -0.4100, 0.3350)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:collisionEnabled = 1
    }
}
