#usda 1.0
(
    defaultPrim = "bread"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bread" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.06

    def "visual" (
        prepend references = @./bread_visual.usd@
    )
    {
        over "collision_proxy" (
            prepend apiSchemas = ["PhysicsMeshCollisionAPI", "PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </bread/phys_mat> (
                bindMaterialAs = "weakerThanDescendants"
            )
            uniform token physics:approximation = "convexHull"
            token visibility = "invisible"
        }
    }

    def Material "phys_mat" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.45
        float physics:staticFriction = 0.5
    }
}

