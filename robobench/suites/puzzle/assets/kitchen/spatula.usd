#usda 1.0
(
    defaultPrim = "spatula"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "spatula" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.15

    def "visual" (
        prepend references = @./spatula_visual.usd@
    )
    {
    }

    def Material "phys_mat" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.12
        float physics:staticFriction = 0.15
    }

    def Cube "blade_col_0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </spatula/phys_mat> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.038923826, 0.0741422, 0.0061343713)
        double3 xformOp:translate = (-0.03892382746386891, 0, 0.0030671856368338062)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

