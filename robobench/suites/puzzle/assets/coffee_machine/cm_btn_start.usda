#usda 1.0
(
    defaultPrim = "root"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """START key VISUAL (E_button_1_9, top-facing — the press is straight down; physics-stripped; body + collider + prismatic travel are authored procedurally by the scene's spawner) + green identity cap."""
)

def Xform "root" (
    prepend references = @./pkg/model_capsule_coffee_maker_3.usd@</root>
)
{
    over "E_body_2" (
        active = false
    )
    {
    }
    over "E_button_2_1" (
        active = false
    )
    {
    }
    over "E_shell_8" (
        active = false
    )
    {
    }
    over "PhysicsMaterial" (
        active = false
    )
    {
    }
    over "PhysicsMaterial_01" (
        active = false
    )
    {
    }
    def Cube "cap_face"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.15, 0.65, 0.2)]
        double3 xformOp:translate = (-0.03, 0.054, 0.3985)
        float3 xformOp:scale = (0.02, 0.02, 0.001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
