#usda 1.0
(
    defaultPrim = "PushL"
    metersPerUnit = 1
    upAxis = "Z"
)

# Authored L block: flat rectilinear puzzle plate, 15 mm thick, matching the vendored RoboDojo T's class and scale. Exact per-slab convex-hull colliders.
def Xform "PushL" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    def Scope "Looks"
    {
        def Material "PushLMat"
        {
            token outputs:surface.connect = </PushL/Looks/PushLMat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.980, 0.700, 0.080)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.32
                float inputs:specular = 0.5
                token outputs:surface
            }
        }
    }
    def Mesh "part_0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI",
                              "MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 0
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [3, 2, 1, 0, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 1, 2, 6, 5, 3, 0, 4, 7]
        point3f[] points = [(-0.036000, -0.032500, -0.007500), (0.038000, -0.032500, -0.007500), (0.038000, -0.007500, -0.007500), (-0.036000, -0.007500, -0.007500), (-0.036000, -0.032500, 0.007500), (0.038000, -0.032500, 0.007500), (0.038000, -0.007500, 0.007500), (-0.036000, -0.007500, 0.007500)]
        float3[] extent = [(-0.036000, -0.032500, -0.007500), (0.038000, -0.007500, 0.007500)]
        color3f[] primvars:displayColor = [(0.980, 0.700, 0.080)] (
            interpolation = "constant"
        )
        rel material:binding = </PushL/Looks/PushLMat>
        uniform token subdivisionScheme = "none"
        bool physics:collisionEnabled = 1
        uniform token physics:approximation = "convexHull"
    }
    def Mesh "part_1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI",
                              "MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 0
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [3, 2, 1, 0, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 1, 2, 6, 5, 3, 0, 4, 7]
        point3f[] points = [(-0.036000, -0.007500, -0.007500), (-0.011000, -0.007500, -0.007500), (-0.011000, 0.044500, -0.007500), (-0.036000, 0.044500, -0.007500), (-0.036000, -0.007500, 0.007500), (-0.011000, -0.007500, 0.007500), (-0.011000, 0.044500, 0.007500), (-0.036000, 0.044500, 0.007500)]
        float3[] extent = [(-0.036000, -0.007500, -0.007500), (-0.011000, 0.044500, 0.007500)]
        color3f[] primvars:displayColor = [(0.980, 0.700, 0.080)] (
            interpolation = "constant"
        )
        rel material:binding = </PushL/Looks/PushLMat>
        uniform token subdivisionScheme = "none"
        bool physics:collisionEnabled = 1
        uniform token physics:approximation = "convexHull"
    }
}
