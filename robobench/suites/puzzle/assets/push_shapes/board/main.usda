#usda 1.0
(
    defaultPrim = "Board"
    metersPerUnit = 1
    upAxis = "Z"
)

# Recessed work board: 6 mm plate the pieces slide on, with piece-shaped cutouts (clearance 4 mm/side) sunk at the three stations; an aligned block DROPS into its recess, which the scene grades. Exact slab decomposition of board-minus-cutouts.
def Xform "Board" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    def Scope "Looks"
    {
        def Material "BoardMat"
        {
            token outputs:surface.connect = </Board/Looks/BoardMat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.600, 0.610, 0.630)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.70
                float inputs:specular = 0.5
                token outputs:surface
            }
        }
    }
    def Mesh "part_0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI",
                              "MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 0
