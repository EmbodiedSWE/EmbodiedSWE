        int[] faceVertexIndices = [3, 2, 1, 0, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 1, 2, 6, 5, 3, 0, 4, 7]
        point3f[] points = [(-0.185000, -0.385000, -0.003000), (-0.104500, -0.385000, -0.003000), (-0.104500, -0.095000, -0.003000), (-0.185000, -0.095000, -0.003000), (-0.185000, -0.385000, 0.003000), (-0.104500, -0.385000, 0.003000), (-0.104500, -0.095000, 0.003000), (-0.185000, -0.095000, 0.003000)]
        float3[] extent = [(-0.185000, -0.385000, -0.003000), (-0.104500, -0.095000, 0.003000)]
        color3f[] primvars:displayColor = [(0.600, 0.610, 0.630)] (
            interpolation = "constant"
        )
        rel material:binding = </Board/Looks/BoardMat>
        uniform token subdivisionScheme = "none"
        bool physics:collisionEnabled = 1
        uniform token physics:approximation = "convexHull"
    }
