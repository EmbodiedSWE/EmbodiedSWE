    def Cylinder "shank_0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.0078, -0.0078, -0.0325), (0.0078, 0.0078, 0.0325)]
        double height = 0.06499999999999997
        rel material:binding = </ChairBase/Looks/Steel>
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        double radius = 0.0078
        quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
        double3 xformOp:translate = (-0.14, 0.2621, 0.397)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "stud_0"
    {
        double3 xformOp:translate = (-0.14, 0.2946, 0.397)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def "bolt" (
            prepend references = @./factory_bolt_m16_yaxis.usd@
        )
        {
            over "factory_bolt_loose" (
                delete apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
            }

            over "root_joint" (
                active = false
            )
            {
            }
        }
    }

    def Cylinder "shank_1" (
