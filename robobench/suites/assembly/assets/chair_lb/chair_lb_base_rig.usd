        {
            token outputs:surface.connect = </ChairBase/Looks/Steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.44, 0.47)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
    }

