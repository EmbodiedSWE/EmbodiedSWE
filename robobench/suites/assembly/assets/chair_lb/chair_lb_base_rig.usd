#usda 1.0
(
    defaultPrim = "ChairBase"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ChairBase" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 6

    def "visual" (
        prepend references = @./chair_lb_base.usd@
    )
    {
    }

    def Scope "Looks"
    {
