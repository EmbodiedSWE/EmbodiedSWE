/videos/

# Experiments — the workspace for agent runs / generated solutions / logs / checkpoints / learned
# skills. Nothing here is committed except the README (so the folder exists, but solutions stay out
# of git). Committed specs + machinery live elsewhere (robobench/, and later agent/ + configs/).
/experiments/*
!/experiments/README.md

# Interactive dev loop (scripts/runpod_dev.py): pod handle and pulled media are per-machine.
.runpod_dev.json
artifacts/
*.npz
*.mp4
rl/runs/

# lerobot venv (scripts/bootstrap_lerobot.sh) — py3.12, separate from the Isaac .venv
.venv-lerobot/

# Large binary assets (USD, textures, policies, reference videos) live on Hugging Face
# (EmbodiedSWE/robobench-assets) and are fetched to these exact paths by
# `python -m robobench.scripts.fetch_assets`. Text layers (usda, mdl, json, provenance) stay in git; every *.usd goes to HF.
# See robobench/assets_manifest.json for the authoritative file list.
robobench/**/assets/**/*.usd
robobench/**/assets/**/*.usdc
robobench/**/assets/**/*.png
robobench/**/assets/**/*.PNG
robobench/**/assets/**/*.jpg
robobench/**/assets/**/*.jpeg
robobench/**/assets/**/*.mp4
robobench/**/assets/**/*.pt
robobench/**/assets/**/*.exr

# Shared room bundles and additional texture formats live on Hugging Face.
robobench/assets/rooms/
robobench/**/assets/**/*.hdr
robobench/**/assets/**/*.tif
robobench/**/assets/**/*.tiff
robobench/**/assets/**/*.dds
robobench/**/assets/**/*.ktx
